  "cards": [
    {
      "dot": "cyan",
      "title": "Harness 与 LangGraph 的关系",
      "items": [
        "Harness 组织任务和工具调用；LangGraph 提供底层运行能力。",
        "二者是构建与承载关系，不是两个独立 Agent 或两级审批。"
      ]
    },
    {
      "dot": "rose",
      "title": "银行操作必须经过安全基座",
      "items": [
        "安全基座获准后调用模拟银行；银行入口再次校验关键条件。",
        "银行实际结果沿调用链返回；安全拒绝或需确认时不执行。"
      ]
    },
    {
      "dot": "amber",
      "title": "用户确认与系统边界",
      "items": [
        "前端经 API 提交请求，以 SSE 接收进度；确认后续办原任务。",
        "v0.4 设计稿，尚未实现验证；当前自建模拟银行，不接真实银行。"
      ]
    }
  ]
