  "cards": [
    {
      "dot": "cyan",
      "title": "主链路与用户确认",
      "items": [
        "前端 → 服务入口 → Agent → 业务模块 → 银行接入层 → 模拟银行。",
        "需要确认时，原任务暂停；用户回答经前端和服务入口返回后继续。"
      ]
    },
    {
      "dot": "rose",
      "title": "安全贯穿各边界",
      "items": [
